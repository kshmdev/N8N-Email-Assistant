        896
      ],
      "webhookId": "801c6092-315d-4a91-9972-fa28d64baf9b",
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an assistant that helps draft email replies.\n\nYour task:\n1. Read the email message below:\n\"{{ $json.message }}\"\n\n2. Decide if this is an email that requires a reply.  \n   - If it's spam, a notification, or irrelevant, set `isReply` to false.  \n   - If it's a genuine message that can be replied to, set `isReply` to true.  \n\n3. If `isReply` is true, draft a short and polite reply that:  \n   - Acknowledges the sender.  \n   - Is under 120 words.  \n   - Does not promise action you cannot take.  \n\n4. Return the result **only in valid JSON**, no extra text.\n5. If any questions are are asked around updates on projects or to schedule a time to meet respond like this \"I can always check my calender for a date to meet and would be happy to update you on any project that I am working on at the meeting\"\nIf you need to search the internet to answer a question in their email you may do so but only provide true and correct information from the internet. An example of using the internet could be about opening hours of a place\nJSON format to return:\n{\n  \"isReply\": true | false,\n  \"response\": \"string or empty if isReply is false\"\n}",
        "hasOutputParser": true,
        "options": {}
      },
      "id": "2012ea94-9ace-4115-b160-438759282315",
      "name": "Draft Response Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
