      "parameters": {
        "jsCode": "const now = new Date();\nconst dayOfWeek = now.getDay(); // 0=Sunday, 6=Saturday\nconst hour = now.getHours();\n\n// Check if weekend (Saturday=6 or Sunday=0)\nconst isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);\n\n// Check if weekday after 5pm (Monday-Friday = 1-5, hour >= 17)\nconst isWeekdayAfter5pm = (dayOfWeek >= 1 && dayOfWeek <= 5 && hour >= 17);\n\n// Determine if we should send auto-reply\nconst shouldReply = isWeekend || isWeekdayAfter5pm;\n\n// Add logic results to each item\nreturn $input.all().map(item => {\n  return {\n    json: {\n      ...item.json,\n      isWeekend: isWeekend,\n      isWeekdayAfter5pm: isWeekdayAfter5pm,\n      shouldReply: shouldReply,\n      replyType: isWeekend ? 'weekend' : 'afterhours'\n    }\n  };\n});"
      },
